{
  "name": "asm-suggero-medusa-backend",
  "version": "0.0.8",
  "description": "A starter for Medusa projects.",
  "author": "Quality Digital",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "telemetry:disable": "medusa telemetry --disable &&",
    "build": "yarn telemetry:disable medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "prestart": "yarn telemetry:disable medusa db:migrate",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "tsc:check": "yarn tsc --noEmit --skipLibCheck -p ."
  },
  "dependencies": {
    "@asmtch/payment-global-payments": "file:.yalc/@asmtch/payment-global-payments",
    "@asmtch/payments-api": "file:.yalc/@asmtch/payments-api",
    "@aws-sdk/client-s3": "^3.978.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.1054.0",
    "@medusajs/admin-sdk": "2.13.4",
    "@medusajs/cli": "2.13.4",
    "@medusajs/framework": "2.13.4",
    "@medusajs/medusa": "2.13.4",
    "@medusajs/notification-sendgrid": "^2.13.4",
    "@medusajs/ui": "^4.0.26",
    "@mikro-orm/postgresql": "^6.6.14",
    "@sendgrid/client": "^8.1.4",
    "@sendgrid/mail": "^8.1.4",
    "@tanstack/react-query": "5.64.2",
    "ajv": "^8.17.1",
    "algoliasearch": "^5.45.0",
    "axios": "^1.16.0",
    "formidable": "^3.5.1",
    "json-2-csv": "^5.5.4",
    "multer": "^2.1.1",
    "ramda": "^0.32.0",
    "stripe": "^20.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.4",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/formidable": "^3.4.5",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/ramda": "^0.31.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "resolutions": {
    "axios": "^1.16.0",
    "multer": "^2.1.1",
    "@mikro-orm/core": "^6.6.10",
    "@mikro-orm/knex": "^6.6.14",
    "@mikro-orm/postgresql": "^6.6.14",
    "fast-uri": "^3.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
